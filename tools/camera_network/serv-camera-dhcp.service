[Unit]
Description=DHCP for the isolated camera Wi-Fi network
After=NetworkManager.service serv-camera-isolation.service
Requires=serv-camera-isolation.service
ConditionHost=servTest

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/serv-bench-network/camera-dnsmasq.conf
Restart=on-failure
RestartSec=5
UMask=0077
RuntimeDirectory=serv-camera-dhcp
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/serv-bench-network
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
RestrictAddressFamilies=AF_INET AF_INET6 AF_PACKET AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
