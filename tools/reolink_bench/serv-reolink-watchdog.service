[Unit]
Description=Bounded recovery of the home Reolink recognizer
After=serv-reolink-stream.service
ConditionHost=servTest

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/serv-reolink/tools/reolink_bench/watchdog.py
TimeoutStartSec=12
RuntimeDirectory=serv-reolink-watchdog
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost 192.168.50.2/32
